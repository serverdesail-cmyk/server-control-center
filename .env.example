# Copy to .env and replace numeric IDs with the unprivileged user running SCC.
SCC_UID=1000
SCC_GID=1000

# Exposed to SCC only. Do not set this to / or another broad system root.
SCC_HOST_ROOT=/srv
SCC_DATA_PATH=/var/lib/server-control-center/data

# Localhost-only is the safe default. Change to 0.0.0.0 only when you have
# configured host firewall rules and understand the network exposure.
SCC_BIND_ADDRESS=127.0.0.1
SCC_PORT=8787

# Use secure cookies for HTTPS (including ngrok HTTPS). If you deliberately
# access SCC over plain HTTP on a trusted LAN, set false and do not expose it
# to the internet over HTTP.
SCC_COOKIE_SECURE=true

# Generate a random one-time token; the installer does this automatically.
SCC_SETUP_TOKEN=replace-with-a-random-one-time-token
SCC_MAX_UPLOAD_BYTES=1073741824

# Optional Minecraft Java server RCON integration (moderation tools)
SCC_MC_RCON_HOST=127.0.0.1
SCC_MC_RCON_PORT=25575
SCC_MC_RCON_PASSWORD=replace-with-a-long-random-secret
